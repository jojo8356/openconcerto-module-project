# Copier en .env puis adapter. .env ne doit PAS être commité.
POSTGRES_USER=openconcerto
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=OpenConcerto

# Ports publiés sur l'hôte, en 127.0.0.1 uniquement.
# 5433 et non 5432 : le cluster PostgreSQL natif de la machine occupe déjà 5432.
PG_HOST_PORT=5433
ADMINER_PORT=8082
